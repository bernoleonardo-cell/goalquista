{
  "rules": {
    "rooms": {
      ".indexOn": ["created"],
      ".read": "auth != null && query.orderByChild == 'created' && query.endAt <= now - 86400000",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host/uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('host/uid').val() === auth.uid || data.child('created').val() < now - 86400000)))",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "created": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "host": {
          ".validate": "newData.hasChildren(['uid', 'name'])",
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "$other": { ".validate": false }
        },
        "guest": {
          ".write": "auth != null && !data.exists() && data.parent().exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid', 'name'])",
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "$other": { ".validate": false }
        },
        "offers": { ".validate": "newData.hasChildren(['a', 'b'])" },
        "state": { ".write": "auth != null && (data.parent().child('host/uid').val() === auth.uid || data.parent().child('guest/uid').val() === auth.uid)" },
        "live": { ".write": "auth != null && (data.parent().child('host/uid').val() === auth.uid || data.parent().child('guest/uid').val() === auth.uid)" },
        "on": {
          "$side": {
            ".write": "auth != null && (($side === 'a' && data.parent().parent().child('host/uid').val() === auth.uid) || ($side === 'b' && data.parent().parent().child('guest/uid').val() === auth.uid))",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
